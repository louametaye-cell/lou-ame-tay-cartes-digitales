{
  "name": "lou-ame-tay-cartes-digitales",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Plateforme SaaS de cartes de visite digitales et CRM terrain pour Lou Ame Tay (CHR Sénégal)",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:lws": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && vite build && node scripts/prepare-lws.js",
    "preview": "vite preview",
    "deploy": "netlify deploy --prod --dir=dist",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "netlify-cli": "^17.37.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
