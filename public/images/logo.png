<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 80" width="280" height="80">
  <defs>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F2D06B" />
      <stop offset="50%" stop-color="#C9A227" />
      <stop offset="100%" stop-color="#997300" />
    </linearGradient>
    <linearGradient id="goldSheen" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000" flood-opacity="0.3"/>
    </filter>
  </defs>
  
  <!-- Emblem Hexagon/Diamond with Monogram -->
  <g transform="translate(10, 6)" filter="url(#shadow)">
    <polygon points="34,2 66,2 66,66 34,66 2,34" fill="#0B1F3A" stroke="url(#goldGrad)" stroke-width="2.5" />
    <circle cx="34" cy="34" r="24" fill="none" stroke="url(#goldGrad)" stroke-width="1.5" stroke-dasharray="4,2" />
    <!-- Monogram LAT -->
    <text x="34" y="42" font-family="'Cinzel', 'Playfair Display', serif, Georgia" font-size="21" font-weight="700" fill="url(#goldGrad)" text-anchor="middle" letter-spacing="1">LAT</text>
  </g>

  <!-- Typography -->
  <text x="88" y="41" font-family="'Poppins', 'Inter', -apple-system, sans-serif" font-size="25" font-weight="800" fill="#0B1F3A" letter-spacing="2.5">LOU AME TAY</text>
  <text x="89" y="59" font-family="'Inter', sans-serif" font-size="10.5" font-weight="600" fill="#C9A227" letter-spacing="4">L'ÂME DE VOTRE STYLE</text>
  <line x1="88" y1="46" x2="250" y2="46" stroke="url(#goldGrad)" stroke-width="1.2" stroke-opacity="0.6" />
</svg>
