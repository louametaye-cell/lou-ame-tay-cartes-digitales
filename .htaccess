# ==============================================================================
# .htaccess — LOU AME TAY v2.0 — CONFIGURATION SERVEUR APACHE LWS
# ==============================================================================
# Hébergeur : LWS (Ligne Web Services)
# Domaine officiel : https://louametay.online

RewriteEngine On

# --- 1. FORCER LE PROTOCOLE HTTPS ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- 2. FORCER LE WWW (Optionnel : décommenter si souhaité) ---
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

# --- 3. PAGE 404 PERSONNALISÉE ---
ErrorDocument 404 /404.html

# --- 4. TYPES MIME MODERNES ---
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest .json
  AddType application/javascript .js .mjs
  AddType image/svg+xml .svg .svgz
</IfModule>

# --- 5. COMPRESSION GZIP / DEFLATE ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json image/svg+xml
</IfModule>

# --- 6. GESTION DU CACHE NAVIGATEUR (PERFORMANCE) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML : 1 heure pour propagation rapide des mises à jour
  ExpiresByType text/html "access plus 1 hour"

  # Styles & Scripts : 1 an (rafraîchis par versionnage)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Données & Manifest PWA
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType application/manifest+json "access plus 1 week"

  # Images & Médias
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# --- 7. HEADERS DE SÉCURITÉ OWASP ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=()"

  # Content Security Policy (autorise Supabase API, CDN qrcode/chartjs, et polices Google)
  Header set Content-Security-Policy "default-src 'self'; connect-src 'self' https://*.supabase.co https://ipapi.co; img-src 'self' data: blob: https://*.supabase.co https://api.qrserver.com; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
</IfModule>

# --- 8. PROTECTION DES FICHIERS SENSIBLES & CODE SOURCE ---
# Bloque les fichiers d'environnement, git, configurations et documentation
# (Préserve manifest.json et les traductions locales/*.json pour le fonctionnement public)
<FilesMatch "(\.(env|git|lock|log|md|sql)|package\.json|package-lock\.json|tsconfig\.json|vite\.config\.ts)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# --- 9. DÉSACTIVER LE LISTING DES DOSSIERS ---
Options -Indexes

# --- 10. PROTECTION ANTI-HOTLINKING DES IMAGES ---
# Autorise les accès directs (scans QR mobiles), Lou Ame Tay, Google, WhatsApp, Facebook, LinkedIn
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?louametay\.online [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?google\. [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?facebook\. [NC]
RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?whatsapp\.(com|net) [NC]
RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?wa\.me [NC]
RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?linkedin\.com [NC]
RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?instagram\.com [NC]
RewriteRule \.(jpg|jpeg|png|gif|svg)$ - [F,NC]
